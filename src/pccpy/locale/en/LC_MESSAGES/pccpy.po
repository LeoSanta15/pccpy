msgid ""
msgstr ""
"Project-Id-Version: pccpy VERSION\n"
"Report-Msgid-Bugs-To: EMAIL@ADDRESS\n"
"POT-Creation-Date: 2026-10-04 20:56+0000\n"
"PO-Revision-Date: 2026-10-04 20:48+0000\n"
"Last-Translator: pccpy <https://github.com/LeoSanta15/pccpy/issues>\n"
"Language: en\n"
"Language-Team: en\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
