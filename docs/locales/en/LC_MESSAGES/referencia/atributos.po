msgid "Cartas de atributos"
msgstr "Attribute charts"

msgid "Carta P: proporción de unidades defectuosas (n constante o variable)."
msgstr "P chart: proportion of defective units (constant or variable n)."

msgid "Parámetros"
msgstr "Parameters"

msgid "Tipo del valor devuelto"
msgstr "Return type"

msgid "Carta NP: número de defectuosos (n constante)."
msgstr "NP chart: number of defectives (constant n)."

msgid "Carta C: número de defectos por unidad de inspección (tamaño constante)."
msgstr "C chart: number of defects per inspection unit (constant size)."

msgid "Carta U: defectos por unidad (tamaño de muestra constante o variable)."
msgstr "U chart: defects per unit (constant or variable sample size)."

msgid "Carta P' de Laney: corrige la sobredispersión/subdispersión de la carta P."
msgstr "Laney P' chart: corrects the over/underdispersion of the P chart."

msgid "Los límites se multiplican por sigma_z, estimada con el rango móvil promedio de los puntajes z estandarizados."
msgstr "The limits are multiplied by sigma_z, estimated with the average moving range of the standardized z scores."

msgid "Carta U' de Laney: corrige la sobredispersión/subdispersión de la carta U."
msgstr "Laney U' chart: corrects the over/underdispersion of the U chart."

