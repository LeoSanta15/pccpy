msgid "Plan de muestreo Dodge-Romig por atributos."
msgstr "Dodge-Romig sampling plan by attributes."

msgid "Proporciona protección al consumidor (LTPD) o calidad media de salida máxima (AOQL), minimizando el número promedio de inspección total (ATI)."
msgstr "Provides consumer protection (LTPD) or maximum average outgoing quality (AOQL), minimizing the average total inspection (ATI)."

msgid "LTPD objetivo en fracción (p.ej. 0.03 para 3%). Exactamente uno de ``ltpd`` o ``aoql`` debe especificarse."
msgstr "Target LTPD as a fraction (e.g. 0.03 for 3%). Exactly one of ``ltpd`` or ``aoql`` must be specified."

msgid "AOQL objetivo en fracción."
msgstr "Target AOQL as a fraction."

msgid "Promedio de proceso (fracción defectiva) estimado. Por defecto 0.01."
msgstr "Estimated process average (defective fraction). Default 0.01."

